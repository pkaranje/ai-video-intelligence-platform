# Database, Redis, AI
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/videosumm
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=sk-your-api-key-here

# AI Model Configuration
AI_MODEL=gpt-4o
AI_BASE_URL=
AGGREGATION_MODEL=gpt-4o

# Extraction (FFmpeg frame extraction settings)
SCENE_THRESHOLD=0.35
FRAME_INTERVAL=150
BATCH_SIZE=5
MAX_FILE_SIZE_MB=500
MAX_DURATION_SEC=600
DATA_ROOT=./data

# Workers (Dramatiq worker pool configuration)
WORKER_COUNT=4
WORKER_CONCURRENCY=3
MAX_RETRIES=3
MIN_BACKOFF_SEC=15
MAX_BACKOFF_SEC=120

# Cleanup (retention and scheduled cleanup)
JOB_TTL_DAYS=7
FAILED_JOB_TTL_DAYS=1
CLEANUP_CRON=0 2 * * *

# Frontend (API URLs visible to client and server)
NEXT_PUBLIC_API_URL=/api/proxy
BACKEND_URL=http://localhost:8000

# Observability
# devtrack-sdk dashboard: typically available at /devtrack or /analytics
